<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:boxedEdges="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top bar: Back + title + menu, fixed at top (not scrolling) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:minHeight="48dp"
                android:textSize="22sp"
                android:layout_marginStart="8dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textSize="22sp"
                android:textColor="?attr/colorPrimary"
                android:gravity="center"
                android:singleLine="true"
                android:layout_marginHorizontal="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⋮"
                android:minHeight="48dp"
                android:textSize="22sp"
                android:layout_marginEnd="0dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="2dp"
            android:scrollbars="none"
            android:fillViewport="true"
            android:overScrollMode="always">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- Font Size -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.Material3.CardView.Filled">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_font_size"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_size_decrease"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="−"
                        android:minHeight="44dp"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <TextView
                        android:id="@+id/tv_font_size_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14sp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorPrimary"
                        android:paddingHorizontal="12dp"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_font_size_increase"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="+"
                        android:minHeight="44dp"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DPI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.Material3.CardView.Filled">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_dpi"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dpi_decrease"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="−"
                        android:minHeight="44dp"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <TextView
                        android:id="@+id/tv_dpi_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="160"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorPrimary"
                        android:paddingHorizontal="12dp"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dpi_increase"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="+"
                        android:minHeight="44dp"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Theme Mode -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.Material3.CardView.Filled">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_theme"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_dark"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/settings_theme_dark"
                        android:minHeight="44dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="14sp"
                        style="@style/Widget.Material3.Button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_light"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/settings_theme_light"
                        android:minHeight="44dp"
                        android:layout_marginStart="6dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="14sp"
                        style="@style/Widget.Material3.Button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Download Path -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_download_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                style="@style/Widget.Material3.CardView.Filled"
                android:minHeight="56dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_download_path"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:layout_marginBottom="4dp"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_download_path"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_download_path_not_set"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Max Concurrent -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.Material3.CardView.Filled">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_max_concurrent"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_concurrent_decrease"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="−"
                        android:minHeight="44dp"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <TextView
                        android:id="@+id/tv_concurrent_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorPrimary"
                        android:paddingHorizontal="12dp"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_concurrent_increase"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="+"
                        android:minHeight="44dp"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</androidx.wear.widget.BoxInsetLayout>